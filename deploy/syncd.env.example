# syncd environment — copy to /etc/syncd/syncd.env, chmod 600, root-owned.
# NEVER commit a real token. Generate one with:
#   openssl rand -hex 32

# Required: bearer token the Aflulit app presents (Settings → Backup → Home server).
SYNCD_TOKEN=REPLACE_WITH_openssl_rand_hex_32

# Listen address. The Cloudflare Tunnel (cloudflared) on the same host
# forwards https://aflulit.creatv.dev to localhost:8787, so bind loopback
# only — nothing else should reach the plain-HTTP port.
SYNCD_ADDR=127.0.0.1:8787

# Where archives are stored (systemd's StateDirectory creates /var/lib/syncd).
SYNCD_DATA_DIR=/var/lib/syncd

# Optional overrides (defaults shown):
# SYNCD_RETENTION_DAYS=30
# SYNCD_MAX_BODY_MB=64

# ---------------------------------------------------------------------------
# Transcription — POST /v1/transcriptions (T12, ADR-0008 §2). Everything below
# is ignored while ASR_ENABLED=false (the route is not registered), so a
# backup-only box needs none of it.
# ---------------------------------------------------------------------------
# ASR_ENABLED=false

# The Whisper model passed to whisper-ctranslate2 as --model. The CLI only
# accepts its own size names (tiny … large-v3, large-v3-turbo, turbo, distil-*);
# a Hugging Face id is refused (verified 2026-10-13). Default: large-v3.
# ASR_MODEL=large-v3
#
# Recommended for Hebrew — ivrit-ai's turbo fine-tune (Apache-2.0, CTranslate2
# build): clone it once (git lfs) and point WHISPER_MODEL_DIRECTORY at it; the
# CLI then loads those weights and --model only has to be a listed size.
# Responses report the directory's base name as `model`.
#   sudo git -C /opt/creatv/models clone https://huggingface.co/ivrit-ai/whisper-large-v3-turbo-ct2
# ASR_MODEL=large-v3-turbo
# WHISPER_MODEL_DIRECTORY=/opt/creatv/models/whisper-large-v3-turbo-ct2

# The CLI inside the existing whisper-ctranslate2 venv.
# WHISPER_CLI=/opt/creatv/whisper-ct2/bin/whisper-ctranslate2
# Local weights (pass-through to --model_directory / --model_dir / --local_files_only):
# WHISPER_MODEL_DIRECTORY=
# WHISPER_MODEL_CACHE=
# WHISPER_LOCAL_FILES_ONLY=false

# Decode settings (bounded; the defaults are Ilan's proven values).
# ASR_DEVICE=cuda                 # cuda | cpu | auto
# ASR_COMPUTE_TYPE=float16        # float16 | int8_float16 | int8 | float32 | default — the home server needs int8 (float16 fails there)
# ASR_BEAM_SIZE=5                 # 1–10
# ASR_VAD_FILTER=true
# ASR_WORD_TIMESTAMPS=false       # true adds --word_timestamps True and fills `words`

# Limits.
# ASR_MAX_AUDIO_SECONDS=60        # 1–120; longer clips are 413 audio_too_long
# ASR_MAX_UPLOAD_MB=10            # 1–32
# ASR_TIMEOUT_SECONDS=120         # 5–150; a slow decode is 503 transcription_unavailable
# ASR_MAX_PARALLEL=1              # 1–2 GPU jobs; extra requests get 429 busy

# Optional second bearer for the ASR route only (>= 16 chars, must differ from
# SYNCD_TOKEN). Unset = the app uses one token for backups and transcription.
# ASR_TOKEN=
